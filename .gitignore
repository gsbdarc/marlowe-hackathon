# Whitelist: only these paths are tracked. Data, results, model weights and secrets never go in this
# repository; the Jev-labeled data lives on the Yens and Marlowe.
/*
!/.gitignore
!/README.md
!/.github/
!/docs/
!/env/
!/scripts/
!/slurm/

# Never commit these anywhere in the tree
.env
data/
results/
runs/
logs/
wandb/
*.parquet
*.jsonl
*.csv
*.log
*.safetensors
*.pt

# Jekyll build output
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/vendor/
docs/.bundle/
docs/Gemfile.lock

# Python and editors
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.DS_Store
